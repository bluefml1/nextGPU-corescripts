<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NextGPU.Launcher</AssemblyName>
    <RootNamespace>NextGPU.Launcher</RootNamespace>
    <Version>1.0.0</Version>
    <Company>nextGPU</Company>
    <Product>NextGPU Launcher</Product>
    <Description>In-session desktop broker: starts games as the already-elevated NextGPU-Admin process via CreateProcessW / ShellExecuteEx.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB1050;SYSLIB1051;SYSLIB1062</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.NetNamedPipe" Version="8.1.2" />
  </ItemGroup>
</Project>
