<Window x:Class="NextGPU.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextGPU Controller"
        Height="820" Width="1360"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BgBrush}">
        <Grid x:Name="LoginHost" Visibility="Visible">
            <Frame x:Name="LoginFrame" NavigationUIVisibility="Hidden"/>
        </Grid>

        <Grid x:Name="MainHost" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarGlowBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14,18,12,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="6,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0">
                                <Border.Background>
                                    <StaticResource ResourceKey="AccentGradientBrush"/>
                                </Border.Background>
                                <TextBlock Text="NG" FontWeight="Bold" FontSize="15" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NextGPU" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Host controller" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SETUP" Style="{StaticResource NavSectionLabel}"/>
                            <Button x:Name="NavGetStartedBtn" Style="{StaticResource NavButton}" Content="Get Started" Click="NavGetStarted_Click"/>
                            <Button x:Name="NavDashboardBtn" Style="{StaticResource NavButton}" Content="Dashboard" Click="NavDashboard_Click"/>

                            <TextBlock Text="STREAMING" Style="{StaticResource NavSectionLabel}"/>
                            <Button x:Name="NavSunshineBtn" Style="{StaticResource NavButton}" Content="Sunshine" Click="NavSunshine_Click"/>
                            <Button x:Name="NavMoonlightBtn" Style="{StaticResource NavButton}" Content="Moonlight" Click="NavMoonlight_Click"/>
                            <Button x:Name="NavVddVadBtn" Style="{StaticResource NavButton}" Content="VDD-VAD" Click="NavVddVad_Click"/>

                            <TextBlock Text="HOST" Style="{StaticResource NavSectionLabel}"/>
                            <Button x:Name="NavUserStorageBtn" Style="{StaticResource NavButton}" Content="User Storage (U:)" Click="NavUserStorage_Click"/>
                            <Button x:Name="NavUserExperienceBtn" Style="{StaticResource NavButton}" Content="User Experience" Click="NavUserExperience_Click"/>
                            <Button x:Name="NavDiskMgmtBtn" Style="{StaticResource NavButton}" Content="Disk Management" Click="NavDiskMgmt_Click"/>
                            <Button x:Name="NavLogsBtn" Style="{StaticResource NavButton}" Content="Logs" Click="NavLogs_Click"/>
                            <Button x:Name="NavSettingsBtn" Style="{StaticResource NavButton}" Content="Settings" Click="NavSettings_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="6,12,0,0">
                        <Border Padding="12" CornerRadius="12" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                            <TextBlock Text="Get Started = full setup. User Storage (U:) = Moonlight tenant drive while on Admin RDP."
                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       FontSize="11" LineHeight="16"/>
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Content="Sign out" Click="SignOut_Click"
                                HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="0,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ToolbarCard}" Margin="8,0,8,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CurrentPageText" Style="{StaticResource PageTitleText}" FontSize="22"/>
                            <TextBlock x:Name="CurrentPageSubtitle" Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="8,0,8,0"
                        Background="{StaticResource ContentSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="16" Padding="3">
                    <Border CornerRadius="13" Background="{StaticResource PageBgBrush}" ClipToBounds="True">
                        <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
