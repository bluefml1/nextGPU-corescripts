<Window x:Class="NextGPU.App.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Height="200" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Border Margin="16" CornerRadius="16" Padding="20" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,14" FontSize="13"/>
            <TextBox x:Name="InputBox"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
