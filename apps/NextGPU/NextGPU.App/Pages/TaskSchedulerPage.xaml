<Page x:Class="NextGPU.App.Pages.TaskSchedulerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Task Scheduler"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,24,20">
        <StackPanel>
            <Border Style="{StaticResource ToolbarCard}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SummaryLine" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="RefreshedLine" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource LinkAccentBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Refresh_Click"/>
                        <Button Content="Open Windows Task Scheduler" Style="{StaticResource SecondaryButton}" Click="OpenTaskSchedulerApp_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="REGISTER &amp; VERIFY" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Text="Re-register tasks after script changes or on a fresh machine. Requires Administrator (UAC)."
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"/>
                    <StackPanel x:Name="RegisterPanel"/>
                </StackPanel>
            </Border>

            <TextBlock Text="MANAGED TASKS" Style="{StaticResource LabelCaptionText}" Margin="0,0,0,10"/>
            <UniformGrid x:Name="TaskCardsPanel" Columns="2"/>
        </StackPanel>
    </ScrollViewer>
</Page>
