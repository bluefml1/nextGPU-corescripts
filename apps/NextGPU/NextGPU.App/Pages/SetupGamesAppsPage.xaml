<Page x:Class="NextGPU.App.Pages.SetupGamesAppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      Title="Setup Games &amp; Apps">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,24,20">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Setup Games &amp; Apps" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Host setup provisions games on the machine. Clean Session resets folders for each rental (logoff + logon fallback)."/>
                </StackPanel>
            </Border>

            <TabControl Style="{StaticResource PageTabControl}">
                <TabItem Header="Host Setup" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="One-time or maintenance: sync official bundles, lay out games/apps, push to cloud origins. Does not run session folder rules."/>
                            <StackPanel x:Name="HostSetupPanel"/>
                        </StackPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Clean Session" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Define delete/replace rules for ProgramData folders. Logoff runs all rules; logon re-runs failed rules when logonFallback is enabled."/>
                            <TextBlock x:Name="RulesCountText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" Margin="0,0,8,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox x:Name="RuleIdBox" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Title" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox x:Name="RuleTitleBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Action (delete / replace)" Margin="0,0,8,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <ComboBox x:Name="RuleActionBox" Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" SelectedIndex="1">
                                    <ComboBoxItem Content="delete"/>
                                    <ComboBoxItem Content="replace"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Target folder" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RuleTargetBox" Grid.Column="0" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="..." Padding="10,4" Click="RuleTargetBrowse_Click"
                                            ToolTip="Browse for target folder"/>
                                </Grid>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Source (replace; empty = session-templates\{id})" Margin="0,0,8,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <Grid Grid.Row="5" Grid.Column="0" Margin="0,0,8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RuleSourceBox" Grid.Column="0" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="..." Padding="10,4" Click="RuleSourceBrowse_Click"
                                            ToolTip="Browse for source template folder"/>
                                </Grid>
                                <StackPanel Grid.Row="4" Grid.Column="1" Grid.RowSpan="2">
                                    <TextBlock Text="Preserve (comma-separated relative paths)" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="RulePreserveBox" Margin="0,0,0,8"/>
                                    <TextBlock Text="Stop processes (comma-separated .exe names)" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="RuleStopProcessesBox" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="RuleLogonFallbackBox" Content="Logon fallback (re-run if logoff incomplete)" IsChecked="True"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel x:Name="RulesFormActionsPanel" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="RulesGridActionsPanel" Margin="0,0,0,8">
                                <TextBox x:Name="RulesFilterBox" Width="200" Margin="0,0,8,0" ToolTip="Search id, title, target" TextChanged="RulesFilter_Changed"/>
                            </WrapPanel>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Double-click text cells to edit. Double-click target or source to pick a folder. Action is a dropdown."/>
                            <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False" CanUserReorderColumns="False"
                                      MaxHeight="200" Margin="0,0,0,8"
                                      BeginningEdit="RulesGrid_BeginningEdit"
                                      CellEditEnding="RulesGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="id" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="90"/>
                                    <DataGridTextColumn Header="title" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="*"/>
                                    <DataGridComboBoxColumn Header="action" Width="75"
                                                            SelectedItemBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                        <DataGridComboBoxColumn.ItemsSource>
                                            <x:Array Type="{x:Type sys:String}">
                                                <sys:String>delete</sys:String>
                                                <sys:String>replace</sys:String>
                                            </x:Array>
                                        </DataGridComboBoxColumn.ItemsSource>
                                    </DataGridComboBoxColumn>
                                    <DataGridTextColumn Header="target" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="*"/>
                                    <DataGridTextColumn Header="source" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="*"/>
                                    <DataGridTextColumn Header="preserve" Binding="{Binding PreserveText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="100"/>
                                    <DataGridTextColumn Header="stop" Binding="{Binding StopProcessesText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="logon" Binding="{Binding LogonFallback, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="RulesGridFooter" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,14"/>
                            <StackPanel x:Name="CleanSessionActionsPanel"/>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Page>
