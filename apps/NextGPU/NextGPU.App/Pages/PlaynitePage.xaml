<Page x:Class="NextGPU.App.Pages.PlaynitePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PlayNite">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,24,20">
        <UniformGrid Columns="2" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,14">
                <StackPanel>
                    <TextBlock Text="PlayNite Setup &amp; Library" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"
                               Text="Requires 7-Zip/WinRAR, Steam/Epic on disk, optional Everything + allowlist. After allowlist changes run Import Desktop Apps then Export to Sunshine."/>
                    <StackPanel x:Name="SetupPanel"/>

                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="DESKTOP APP ALLOWLIST" Style="{StaticResource LabelCaptionText}" VerticalAlignment="Center"/>
                                <Button Content="?" Style="{StaticResource HelpIconButton}" Click="AllowlistHelp_Click"
                                        ToolTip="What is the desktop app allowlist?" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Button x:Name="ToggleAllowlistFormBtn" Content="Hide Add Form" Style="{StaticResource GhostButton}"
                                        Click="ToggleAllowlistForm_Click" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock x:Name="AllowlistCountText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,10"/>

                            <StackPanel x:Name="AllowlistAddFormPanel">
                                <TextBlock Text="Type" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <ComboBox x:Name="AllowlistTypeCombo" Margin="0,0,0,10" SelectionChanged="AllowlistForm_Changed"/>

                                <TextBlock Text="Executable (filename only)" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox x:Name="AllowlistExeBox" Margin="0,0,0,10" TextChanged="AllowlistForm_Changed"/>

                                <TextBlock Text="Slot / Name ID" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox x:Name="AllowlistSlotBox" Margin="0,0,0,4" TextChanged="AllowlistForm_Changed"/>

                                <TextBlock x:Name="NameIdPreviewText" Foreground="{StaticResource LinkAccentBrush}" FontSize="12" Margin="0,0,0,10"/>

                                <TextBlock Text="Title (optional)" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox x:Name="AllowlistTitleBox" Margin="0,0,0,12"/>

                                <WrapPanel x:Name="AllowlistActionsPanel" Margin="0,0,0,14"/>
                            </StackPanel>
                            <WrapPanel x:Name="AllowlistViewerActionsPanel" Margin="0,0,0,8"/>
                            <StackPanel x:Name="AllowlistViewerPanel" Visibility="Collapsed">
                                <WrapPanel x:Name="AllowlistGridActionsPanel" Margin="0,0,0,8">
                                    <TextBox x:Name="AllowlistFilterBox" Width="200" Margin="0,0,8,0" ToolTip="Search exe, title, nameId, type" TextChanged="AllowlistFilter_Changed"/>
                                    <ComboBox x:Name="AllowlistTypeFilterCombo" Width="160" Margin="0,0,8,0" SelectionChanged="AllowlistFilter_Changed"/>
                                </WrapPanel>
                                <DataGrid x:Name="AllowlistGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                          MaxHeight="220" Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="exe" Binding="{Binding Exe}" Width="*"/>
                                        <DataGridTextColumn Header="nameId" Binding="{Binding NameId}" Width="90"/>
                                        <DataGridTextColumn Header="title" Binding="{Binding Title}" Width="*"/>
                                        <DataGridTextColumn Header="type" Binding="{Binding Type}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="AllowlistGridFooter" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="PLAYNITE LIBRARY" Style="{StaticResource LabelCaptionText}" VerticalAlignment="Center"/>
                                <Button Content="?" Style="{StaticResource HelpIconButton}" Click="LibraryHelp_Click"
                                        ToolTip="Browse games.db for bypass sync configuration" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Button x:Name="ToggleLibraryViewerBtn" Content="View Library" Style="{StaticResource GhostButton}"
                                        Click="ToggleLibraryViewer_Click" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock x:Name="LibraryCountText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,10"/>
                            <StackPanel x:Name="LibraryViewerPanel" Visibility="Collapsed">
                                <WrapPanel x:Name="LibraryGridActionsPanel" Margin="0,0,0,8">
                                    <TextBox x:Name="LibraryFilterBox" Width="200" Margin="0,0,8,0" ToolTip="Search name, gameId, nameId, source" TextChanged="LibraryFilter_Changed"/>
                                    <ComboBox x:Name="LibrarySourceFilterCombo" Width="120" Margin="0,0,8,0" SelectionChanged="LibraryFilter_Changed"/>
                                </WrapPanel>
                                <DataGrid x:Name="LibraryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                          MaxHeight="220" Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="name" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="source" Binding="{Binding Source}" Width="70"/>
                                        <DataGridTextColumn Header="gameId" Binding="{Binding GameId}" Width="80"/>
                                        <DataGridTextColumn Header="nameId" Binding="{Binding NameId}" Width="80"/>
                                        <DataGridTextColumn Header="exe" Binding="{Binding Exe}" Width="*"/>
                                        <DataGridTextColumn Header="playPath" Binding="{Binding PlayPath}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel x:Name="LibraryActionsPanel" Margin="0,0,0,6"/>
                                <TextBlock x:Name="LibraryGridFooter" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Sunshine Export &amp; Watcher" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusBadgeText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    </WrapPanel>
                    <StackPanel x:Name="ExportPanel"/>

                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <WrapPanel x:Name="VerifyActionsPanel" Margin="0,0,0,8"/>
                            <StackPanel x:Name="VerifyResultsPanel" Visibility="Collapsed">
                                <TextBlock x:Name="VerifySummaryText" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel x:Name="VerifyChecksPanel"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </UniformGrid>
    </ScrollViewer>
</Page>
