<Page x:Class="NextGPU.App.Pages.PlaynitePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PlayNite">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,24,20">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PlayNite" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Portable Playnite setup, desktop allowlist, Sunshine export, library browser, and host status verify. NextGPU-Admin and Clean Session live under HOST → Bypass."/>
                </StackPanel>
            </Border>

            <TabControl Style="{StaticResource PageTabControl}">
                <TabItem Header="Setup" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Install or repair portable Playnite, update libraries, import desktop apps, and open folders."/>
                            <StackPanel x:Name="SetupPanel"/>

                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="NEXTGPU LAUNCHER SERVICE" Style="{StaticResource LabelCaptionText}" VerticalAlignment="Center"/>
                                        <Button Content="?" Style="{StaticResource HelpIconButton}" Click="NextGpuServiceHelp_Click"
                                                ToolTip="Background service for Moonlight game launches" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <Button x:Name="RefreshNextGpuServiceBtn" Content="Refresh" Style="{StaticResource GhostButton}"
                                                Click="RefreshNextGpuService_Click" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Text="Note: Primary service install is moving to HOST → Bypass. This card remains for quick status, start/stop, and repair."/>
                                    <TextBlock x:Name="NextGpuServiceStateText" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="NextGpuServicePathText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel x:Name="NextGpuServiceActionsPanel" Margin="0,0,0,8"/>
                                    <StackPanel x:Name="NextGpuServiceProgressPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                        <TextBlock x:Name="NextGpuServiceProgressText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Export" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Export Playnite games to Sunshine apps.json, install PlayNiteWatcher hooks, and open export logs."/>
                            <StackPanel x:Name="ExportPanel"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Allowlist" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="DESKTOP APP ALLOWLIST" Style="{StaticResource LabelCaptionText}" VerticalAlignment="Center"/>
                                <Button Content="?" Style="{StaticResource HelpIconButton}" Click="AllowlistHelp_Click"
                                        ToolTip="Desktop apps exported to Sunshine for Moonlight" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Button x:Name="ToggleAllowlistFormBtn" Content="Add App" Style="{StaticResource GhostButton}"
                                        Click="ToggleAllowlistForm_Click" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock x:Name="AllowlistCountText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="AllowlistActionsPanel" Margin="0,0,0,10"/>

                            <StackPanel x:Name="AllowlistAddFormPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Margin="0,0,8,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <ComboBox x:Name="AllowlistTypeCombo" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"
                                              SelectionChanged="AllowlistForm_Changed"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Executable (filename only)" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="AllowlistExeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                             TextChanged="AllowlistForm_Changed"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Slot / Name ID" Margin="0,0,8,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="AllowlistSlotBox" Grid.Row="3" Grid.Column="0" Margin="0,0,8,8"
                                             TextChanged="AllowlistForm_Changed"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Title (optional)" Margin="0,0,0,4" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBox x:Name="AllowlistTitleBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                                             TextChanged="AllowlistForm_Changed"/>
                                    <TextBlock x:Name="NameIdPreviewText" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,8"/>
                                </Grid>
                            </StackPanel>

                            <WrapPanel x:Name="AllowlistViewerActionsPanel" Margin="0,0,0,8"/>
                            <StackPanel x:Name="AllowlistViewerPanel" Visibility="Collapsed">
                                <WrapPanel x:Name="AllowlistGridActionsPanel" Margin="0,0,0,8">
                                    <TextBox x:Name="AllowlistFilterBox" Width="200" Margin="0,0,8,0"
                                             ToolTip="Search exe, title, nameId, type" TextChanged="AllowlistFilter_Changed"/>
                                    <ComboBox x:Name="AllowlistTypeFilterCombo" Width="140" Margin="0,0,8,0"
                                              SelectionChanged="AllowlistFilter_Changed"/>
                                </WrapPanel>
                                <DataGrid x:Name="AllowlistGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserSortColumns="False" CanUserReorderColumns="False"
                                          MaxHeight="220" Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="exe" Binding="{Binding Exe}" Width="*"/>
                                        <DataGridTextColumn Header="nameId" Binding="{Binding NameId}" Width="80"/>
                                        <DataGridTextColumn Header="title" Binding="{Binding Title}" Width="*"/>
                                        <DataGridTextColumn Header="type" Binding="{Binding Type}" Width="90"/>
                                        <DataGridTemplateColumn Header="runAsAdmin" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding RunAsAdmin, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              Checked="AllowlistSkipAcl_Changed"
                                                              Unchecked="AllowlistSkipAcl_Changed"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="AllowlistGridFooter" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Library" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="PLAYNITE LIBRARY" Style="{StaticResource LabelCaptionText}" VerticalAlignment="Center"/>
                                <Button Content="?" Style="{StaticResource HelpIconButton}" Click="LibraryHelp_Click"
                                        ToolTip="Browse games.db library entries" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Button x:Name="ToggleLibraryViewerBtn" Content="View Library" Style="{StaticResource GhostButton}"
                                        Click="ToggleLibraryViewer_Click" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock x:Name="LibraryCountText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,10"/>
                            <StackPanel x:Name="LibraryViewerPanel" Visibility="Collapsed">
                                <WrapPanel x:Name="LibraryGridActionsPanel" Margin="0,0,0,8">
                                    <TextBox x:Name="LibraryFilterBox" Width="200" Margin="0,0,8,0"
                                             ToolTip="Search name, gameId, nameId, source" TextChanged="LibraryFilter_Changed"/>
                                    <ComboBox x:Name="LibrarySourceFilterCombo" Width="120" Margin="0,0,8,0"
                                              SelectionChanged="LibraryFilter_Changed"/>
                                </WrapPanel>
                                <DataGrid x:Name="LibraryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserSortColumns="False" CanUserReorderColumns="False"
                                          SelectionMode="Single"
                                          MaxHeight="220" Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="name" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="source" Binding="{Binding Source}" Width="70"/>
                                        <DataGridTextColumn Header="gameId" Binding="{Binding GameId}" Width="80"/>
                                        <DataGridTextColumn Header="nameId" Binding="{Binding NameId}" Width="80"/>
                                        <DataGridTextColumn Header="exe" Binding="{Binding Exe}" Width="*"/>
                                        <DataGridTextColumn Header="playPath" Binding="{Binding PlayPath}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel x:Name="LibraryActionsPanel" Margin="0,0,0,6"/>
                                <TextBlock x:Name="LibraryGridFooter" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Verify" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Run Test-PlayniteHostStatus.ps1 for install, rental ACL, libraries, allowlist, Sunshine export, and watcher checks."/>
                            <WrapPanel x:Name="VerifyActionsPanel" Margin="0,0,0,12"/>
                            <StackPanel x:Name="VerifyResultsPanel" Visibility="Collapsed">
                                <TextBlock x:Name="VerifySummaryText" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="StatusBadgeText" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <StackPanel x:Name="VerifyChecksPanel"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Page>
