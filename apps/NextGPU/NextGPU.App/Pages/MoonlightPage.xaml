<Page x:Class="NextGPU.App.Pages.MoonlightPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,24,20">
        <Border Style="{StaticResource CardBorder}" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Moonlight / Tunnel Controls" Style="{StaticResource SectionTitleText}"/>
                <StackPanel x:Name="ControlPanel"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
