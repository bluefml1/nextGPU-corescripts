<Page x:Class="NextGPU.App.Pages.NextGPUServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="NextGPU Service">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,24,20">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="NextGPU Service" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Game launcher service (named pipe NextGPUControl) and launch companions: helper apps the service starts as NextGPU-Admin right before an elevated app."/>
                </StackPanel>
            </Border>

            <TabControl Style="{StaticResource PageTabControl}">
                <TabItem Header="Service" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <TextBlock Text="NEXTGPU SERVICE" Style="{StaticResource LabelCaptionText}" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock x:Name="ServiceStateText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <Button x:Name="RefreshServiceBtn" Content="Refresh" Style="{StaticResource GhostButton}" Padding="10,6" Margin="12,0,0,0"
                                        Click="RefreshService_Click" ToolTip="Re-query NextGPUService installation and run state"/>
                            </WrapPanel>
                            <TextBlock x:Name="ServicePathText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel x:Name="ServiceProgressPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                <TextBlock x:Name="ServiceProgressText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                            </StackPanel>
                            <WrapPanel x:Name="ServiceActionsPanel" Margin="0,0,0,8"/>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="Install and Re-register (repair) also seed launch companions from config\launch-companions.defaults.json."/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Launch Companions" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="When NextGPUService elevates a main app listed here, it first starts each companion as NextGPU-Admin in the streaming session (skipped if already running). Apps not listed launch alone. Enter exe file names only; Find paths resolves full paths with Everything."/>
                            <TextBlock x:Name="CompanionsCountText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="CompanionsEditActionsPanel" Margin="0,0,0,8"/>
                            <DataGrid x:Name="CompanionsGrid" AutoGenerateColumns="False" IsReadOnly="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False" CanUserReorderColumns="False"
                                      MaxHeight="300" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="main app exe" Binding="{Binding MainExe, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="120"/>
                                    <DataGridTextColumn Header="companion exe" Binding="{Binding ExeName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="130"/>
                                    <DataGridTextColumn Header="resolved path" Binding="{Binding Exe, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="*"/>
                                    <DataGridTextColumn Header="search folder" Binding="{Binding SearchDir, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="*"/>
                                    <DataGridTextColumn Header="delay ms" Binding="{Binding DelayMs, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="65"/>
                                    <DataGridTextColumn Header="status" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Double-click a cell to edit. Delay is capped at 2000 ms. Save writes the file with an admin-only ACL; the service ignores the file if non-admins can modify it."/>
                            <StackPanel x:Name="CompanionsProgressPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                <TextBlock x:Name="CompanionsProgressText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                            </StackPanel>
                            <WrapPanel x:Name="CompanionsActionsPanel"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Logs" Style="{StaticResource PageTabItem}">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,12,12,12"
                            Padding="16"
                            Margin="0,-1,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Service log (companion start / skip lines), companion seeding log, and ProgramData\nextGPU."/>
                            <StackPanel x:Name="LogsPanel"/>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</Page>
