<Page x:Class="NextGPU.App.Pages.UserExperiencePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,24,20">
        <UniformGrid Columns="2" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,14">
                <StackPanel>
                    <TextBlock Text="Desktop &amp; Wallpaper" Style="{StaticResource SectionTitleText}"/>
                    <StackPanel x:Name="DesktopPanel"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Game/App Data Sync" Style="{StaticResource SectionTitleText}"/>
                    <StackPanel x:Name="DataPanel"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </ScrollViewer>
</Page>
