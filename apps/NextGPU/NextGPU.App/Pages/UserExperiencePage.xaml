<Page x:Class="NextGPU.App.Pages.UserExperiencePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,24,20">
        <Border Style="{StaticResource CardBorder}" MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Desktop &amp; Wallpaper" Style="{StaticResource SectionTitleText}"/>
                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,12"
                           Text="Wallpaper policy and nextGPU desktop cleanup. Game sync and session rules are on Setup Games &amp; Apps."/>
                <StackPanel x:Name="DesktopPanel"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
