<Page x:Class="NextGPU.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,24,20">
        <Border Style="{StaticResource CardBorder}" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="REPOSITORY" Style="{StaticResource LabelCaptionText}"/>
                <TextBlock Text="Repo root override (optional)" Margin="0,0,0,6" Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBox x:Name="RepoBox" Margin="0,0,0,8"/>
                <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,22"
                           Text="Leave empty to auto-detect nextGPU-corescripts from NEXTGPU_REPO_ROOT or parent folders."/>

                <TextBlock Text="DASHBOARD" Style="{StaticResource LabelCaptionText}"/>
                <TextBlock Text="Refresh interval (seconds)" Margin="0,0,0,6" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="IntervalCombo" Margin="0,0,0,24" MaxWidth="140" HorizontalAlignment="Left">
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="30" IsSelected="True"/>
                    <ComboBoxItem Content="60"/>
                </ComboBox>

                <WrapPanel>
                    <Button Content="Save and re-detect repo" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0,0,10,0"/>
                    <Button Content="Open Get Started" Style="{StaticResource SecondaryButton}" Click="OpenGetStarted_Click"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText" Margin="0,16,0,0" Foreground="{StaticResource LinkAccentBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
