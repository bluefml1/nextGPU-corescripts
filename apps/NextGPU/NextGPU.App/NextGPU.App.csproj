<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <AssemblyName>NextGPU</AssemblyName>
    <RootNamespace>NextGPU.App</RootNamespace>
    <Version>1.0.0</Version>
    <Company>nextGPU</Company>
    <Product>NextGPU Controller</Product>
    <Description>Operator dashboard for nextGPU-corescripts GPU hosts</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)'=='win-x64'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NextGPU.Core\NextGPU.Core.csproj" />
  </ItemGroup>
</Project>
