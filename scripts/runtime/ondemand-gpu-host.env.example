# Copy to %ProgramData%\nextGPU\secrets\ondemand-gpu-host.env (Administrator only).
# Or set machine environment variable NEXTGPU_ONDEMAND_GPU_HOST_API_KEY.
# Separate from registerMachine API key — used for onDemandGPUHost vendor shutdown only.
# Never commit real credentials to git. Rotate keys if they were exposed.

NEXTGPU_ONDEMAND_GPU_HOST_API_KEY=your_api_key_here
