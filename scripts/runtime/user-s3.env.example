# Copy to %ProgramData%\nextGPU\secrets\user-s3.env (Administrator only).
# Or set machine environment variables NEXTGPU_USER_S3_ACCESS_KEY / NEXTGPU_USER_S3_SECRET_KEY.
# Never commit real credentials to git. Rotate keys if they were exposed.

NEXTGPU_USER_S3_ACCESS_KEY=AKIAxxxxxxxxxxxxxxxx
NEXTGPU_USER_S3_SECRET_KEY=your_secret_access_key_here
