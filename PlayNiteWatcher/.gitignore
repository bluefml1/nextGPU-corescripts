*.txt
*.json
*.zip
*.log
!config/playnite/desktop-apps.allowlist.json.template
!config/playnite/*.template.json
!config/playnite/*.json.template

# Auto-downloaded SQLite CLI (see Playnite-Common.ps1 Ensure-Sqlite3Available)
tools/sqlite/*
!tools/sqlite/.gitkeep

# Guard against accidental relative DatabasePath outputs
library/

# Per-machine install folder from Setup folder picker
PlayniteInstall.path

# Committed Steam extension package required by Setup-PlayniteSteam
# (un-ignore under broad *.json / *.txt rules above)
!SteamExtensions/build/
!SteamExtensions/build/**
